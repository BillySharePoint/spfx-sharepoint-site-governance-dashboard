  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab", "SharePointFullPage"],
  "supportsThemeVariants": true,

  "preconfiguredEntries": [{
    "groupId": "5c03119e-3074-46fd-976b-c60198311f70", // Advanced
    "group": { "default": "Governance" },
    "title": { "default": "Site Governance Dashboard" },
    "description": { "default": "Monitor SharePoint governance health — ownership, permissions, sharing, content freshness, and compliance signals" },
    "officeFabricIconFontName": "Shield",
    "properties": {
      "description": "Site Governance Dashboard"
    }
  }]
}
